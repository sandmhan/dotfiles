# .editorconfig for Nix codebase

# Top-level EditorConfig settings
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Nix-specific settings
[*.nix]
indent_style = tab
indent_size = 2
max_line_length = 80

