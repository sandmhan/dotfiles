# Tailscale Secrets - Example Template
# Copy to secrets.yaml and populate with actual values, then encrypt with sops

# Tailscale auth key for automatic node enrollment
# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key scoped to your tailnet for homelab nodes
tailscale/auth-key: tskey-auth-EXAMPLE

# Steps to populate this file:
# 1. Go to Tailscale admin console → Settings → Keys
# 2. Generate an auth key:
#    - Reusable: yes (so multiple VMs can use it)
#    - Ephemeral: yes (nodes auto-deregister when offline for 30+ days)
#    - Tags: tag:homelab (optional, for ACL-based access control)
#    - Expiry: 90 days (regenerate before expiry)
# 3. Paste the key above, then encrypt:
#    sops secrets/tailscale/secrets.yaml
