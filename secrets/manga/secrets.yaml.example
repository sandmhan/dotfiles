# Manga Stack Secrets - Example Template
# Copy to secrets.yaml and populate with actual values, then encrypt with sops

# Komga initial admin password (set on first login, can be changed in UI after)
# Not strictly required — Komga prompts for admin creation on first boot.
# Included here for automated/headless provisioning if needed in the future.
# komga-admin-password: your_secure_komga_admin_password_here

# Steps to populate this file:
# 1. Copy this file:
#    cp secrets.yaml.example secrets.yaml
#
# 2. Fill in actual values (or leave commented if using interactive setup)
#
# 3. Encrypt with sops:
#    sops -e -i secrets.yaml
#
# 4. Ensure .sops.yaml includes the manga host's age key

# Service endpoints after deployment:
# - Komga:    http://[manga-host]:25600 (or via nginx at port 80)
# - Suwayomi: http://[manga-host]:4567  (or via nginx at port 80)
#
# Mihon setup:
# - Install Keiyoushi extensions repo in Mihon
# - Add Komga extension, configure server URL
# - Add Suwayomi extension, configure server URL
