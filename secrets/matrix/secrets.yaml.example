# Matrix server secrets
# Copy to secrets.yaml and encrypt: sops secrets/matrix/secrets.yaml

# TURN server shared secret (for VoIP/video calls)
# Generate with: openssl rand -hex 32
turn_secret: "REGENERATE_WITH_RANDOM_STRING"

# ACME/Let's Encrypt email for SSL certificates
acme_email: "admin@yourdomain.com"

# Matrix registration shared secret
# Generate with: openssl rand -hex 32
registration_shared_secret: "REGENERATE_WITH_RANDOM_STRING"
