# Shared secrets accessible by multiple hosts
# Copy to secrets.yaml and encrypt: sops secrets/shared/secrets.yaml

# SSH public keys for authorized access
ssh:
  admin_key: "ssh-ed25519 AAAAC3... admin@workstation"
  backup_key: "ssh-ed25519 AAAAC3... backup@server"

# User account
users:
  sandmhan:
    password_hash: "$6$rounds=4096$..."

# Shared service credentials
services:
  grafana_admin_password: "grafana_password"
  restic_password: "backup_encryption_password"
