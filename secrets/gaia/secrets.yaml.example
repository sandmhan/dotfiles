# Desktop (gaia) secrets
# Copy to secrets.yaml and encrypt: sops secrets/gaia/secrets.yaml

# User account
user:
  password_hash: "$6$rounds=4096$..." # mkpasswd -m sha-512

# Development tokens
development:
  github_token: "ghp_..."
  anthropic_api_key: "sk-ant-..."

# WiFi networks
wifi:
  home:
    ssid: "YourHomeWiFi"
    password: "wifi_password"
