# WireGuard VPN Secrets - Example Template
# Copy to secrets.yaml and populate with actual values, then encrypt with sops

# Server private key (generate with: wg genkey)
server-private-key: ENC[AES256_GCM,data:EXAMPLE_ENCRYPTED_DATA,type:str]

# Client configurations as JSON array
# Each client needs: publicKey, allowedIPs, optional presharedKey
clients: ENC[AES256_GCM,data:EXAMPLE_ENCRYPTED_JSON_ARRAY,type:str]

# Example of unencrypted client format (encrypt after populating):
# clients: |
#   [
#     {
#       "name": "laptop-framework",
#       "publicKey": "client_public_key_1_here",
#       "allowedIPs": ["10.100.0.2/32"],
#       "comment": "Framework laptop for remote homelab access"
#     },
#     {
#       "name": "phone-android",
#       "publicKey": "client_public_key_2_here",
#       "allowedIPs": ["10.100.0.3/32"],
#       "presharedKey": "optional_preshared_key_here",
#       "comment": "Android phone for mobile access"
#     },
#     {
#       "name": "tablet-ipad",
#       "publicKey": "client_public_key_3_here",
#       "allowedIPs": ["10.100.0.4/32"],
#       "comment": "iPad for casual access"
#     }
#   ]

# Steps to populate this file:
# 1. Generate server keypair:
#    SERVER_PRIVATE_KEY=$(wg genkey)
#    SERVER_PUBLIC_KEY=$(echo $SERVER_PRIVATE_KEY | wg pubkey)
#
# 2. Generate client keypairs for each device:
#    CLIENT_PRIVATE_KEY=$(wg genkey)
#    CLIENT_PUBLIC_KEY=$(echo $CLIENT_PRIVATE_KEY | wg pubkey)
#
# 3. Optional preshared keys for additional security:
#    PRESHARED_KEY=$(wg genpsk)
#
# 4. Fill in the actual keys above, then encrypt with sops:
#    sops -e secrets.yaml.example > secrets.yaml
#
# 5. Update .sops.yaml to include this file in the wireguard configuration