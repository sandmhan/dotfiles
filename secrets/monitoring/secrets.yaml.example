# Monitoring Stack Secrets - Example Template
# Copy to secrets.yaml and populate with actual values, then encrypt with sops

# Grafana admin password
grafana-admin-password: ENC[AES256_GCM,data:EXAMPLE_ENCRYPTED_DATA,type:str]

# SMTP credentials for Grafana notifications (optional)
smtp-password: ENC[AES256_GCM,data:EXAMPLE_ENCRYPTED_DATA,type:str]

# Example of unencrypted format (encrypt after populating):
# grafana-admin-password: your_secure_grafana_admin_password_here
# smtp-password: your_smtp_password_here

# Steps to populate this file:
# 1. Generate secure Grafana admin password:
#    GRAFANA_ADMIN_PASSWORD=$(openssl rand -base64 32)
#
# 2. If using SMTP notifications, get SMTP credentials from your provider
#
# 3. Fill in the actual passwords above, then encrypt with sops:
#    sops -e secrets.yaml.example > secrets.yaml
#
# 4. Update .sops.yaml to include this file in monitoring configuration

# Default admin user: admin
# Access Grafana at: http://[monitoring-host]:3000
# Use the encrypted password from this file

# Dashboard recommendations:
# - Node Exporter Full (built-in)
# - Prometheus Stats (built-in)
# - Custom homelab service dashboards

